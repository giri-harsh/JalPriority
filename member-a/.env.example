# --- A-owned -----------------------------------------------------------
A_PORT=8001
# A_DATA_DIR=            # default: <member-a>/data  (Docker: /app/data)
# A_MODELS_DIR=          # default: <member-a>/models (Docker: /app/models)
A_STORAGE_MODE=local     # local | s3
A_S3_BUCKET=
A_S3_PREFIX=a/
A_MODEL_MODE=local       # local | s3 | sagemaker_endpoint
A_SAGEMAKER_ENDPOINT=
A_SAGEMAKER_ROLE_ARN=
A_AWS_REGION=ap-south-1
A_SOLVER_TIME_LIMIT_S=8.0
A_COVERAGE_FLOOR=0.25
A_FLOOR_PENALTY=3.0
A_SEED=42
A_AUTH_DISABLED=false    # local tests only; MUST be false at integration
A_CORS_ORIGINS=http://localhost:5174

# --- harness only (dashboard/.env.example mirrors these) ---------------
VITE_A_HARNESS_PLAN_SOURCE=solve   # solve | fixture
VITE_A_DEV_TOKEN=                  # python scripts/mint_dev_token.py

# --- SHARED (contract-owned, read-only) --------------------------------
SHARED_JWT_SECRET=dev-only-jalpriority-secret-change-me-0123456789
SHARED_JWT_ISSUER=jalpriority-b
SHARED_JWT_AUDIENCE=jalpriority
SHARED_ENV=local
SHARED_LOG_LEVEL=INFO
